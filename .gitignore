# Dependencies and package-manager caches (keep package-lock.json)
node_modules/
/.npm/
/.pnpm-store/

# Next.js generated files and static export
/.next/
/out/
/build/
/dist/
/next-env.d.ts
*.tsbuildinfo

# Local environment and credentials
.env
.env.*
!.env.example
!.env.*.example
!.env.template
*.pem
*.key
*.p12
*.pfx

# Hosting and development-tool state
/.vercel/
/.netlify/
/.impeccable/
/.cache/
/.turbo/
.eslintcache
.stylelintcache

# Test output and browser reports
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/

# Logs and process files
*.log
*.log.*
*.pid
*.pid.lock

# Personal editor settings and backup files
/.idea/
/.vscode/
*.swp
*.swo
*~
*.orig

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local-only scratch work; keep source, public assets, and guides tracked
/.local/
/tmp/
/temp/
